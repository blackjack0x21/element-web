.mx_GlobalShortcutSettings {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
}

.mx_GlobalShortcutSettings_row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--cpd-space-2x);
}

.mx_GlobalShortcutSettings_controls {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
}

.mx_GlobalShortcutSettings_error {
    flex-basis: 100%;
    color: var(--cpd-color-text-critical-primary);
}
