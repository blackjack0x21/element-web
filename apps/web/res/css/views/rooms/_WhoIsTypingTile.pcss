/* Floats over the bottom of the timeline, so messages scroll underneath it. The message list reserves
   the same height at its bottom so the last message is never covered. */
.mx_WhoIsTypingTile {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    pointer-events: none;
    box-sizing: border-box;
    height: var(--WhoIsTypingTile-height);
    background: linear-gradient(to top, var(--cpd-color-bg-canvas-default) 10%, transparent);
    padding: 0 var(--cpd-space-4x);
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    overflow: hidden;
    font: var(--cpd-font-body-sm-medium);
    color: var(--cpd-color-text-primary);
}

.mx_WhoIsTypingTile_dots {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 3px;

    > span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--cpd-color-icon-secondary);
        animation: mx_WhoIsTypingTile_bounce 1.2s infinite ease-in-out;

        &:nth-child(2) {
            animation-delay: 0.2s;
        }

        &:nth-child(3) {
            animation-delay: 0.4s;
        }
    }
}

.mx_WhoIsTypingTile_label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

@keyframes mx_WhoIsTypingTile_bounce {
    0%,
    60%,
    100% {
        opacity: 0.4;
        transform: translateY(0);
    }
    30% {
        opacity: 1;
        transform: translateY(-3px);
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_WhoIsTypingTile_dots > span {
        animation: none;
    }
}
