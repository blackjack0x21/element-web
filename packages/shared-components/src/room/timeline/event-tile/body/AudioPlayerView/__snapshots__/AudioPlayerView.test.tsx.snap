        value="30"
      />
      <time
        class="mx_Clock AudioPlayerView-module_clock"
        datetime="PT2M"
        role="timer"
      >
        02:00
      </time>
      <div
        class="VolumeSlider-module_volumeSlider"
      >
        <svg
          aria-hidden="true"
          class="VolumeSlider-module_icon"
          fill="currentColor"
          height="16px"
          viewBox="0 0 24 24"
          width="16px"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 10a2 2 0 0 1 2-2h2l3.293-3.293c.63-.63 1.707-.184 1.707.707v13.172c0 .89-1.077 1.337-1.707.707L7 16H5a2 2 0 0 1-2-2zm4.828 4L10 16.172V7.828L7.828 10H5v4zm6.294-5.536a1 1 0 0 1 1.414 0A5 5 0 0 1 17 12c0 1.38-.56 2.632-1.464 3.535a1 1 0 1 1-1.415-1.414 3 3 0 0 0 .88-2.121c0-.829-.335-1.578-.88-2.122a1 1 0 0 1 0-1.414"
