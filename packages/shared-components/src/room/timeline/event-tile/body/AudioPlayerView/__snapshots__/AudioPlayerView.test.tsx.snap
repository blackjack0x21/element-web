            datetime="PT5M"
          >
            05:00
          </time>
          (3.42 KB)
        </div>
      </div>
    </div>
    <div
      class="Flex-module_flex"
      data-testid="audio-player-seek"
      style="--mx-flex-display: flex; --mx-flex-direction: row; --mx-flex-align: center; --mx-flex-justify: start; --mx-flex-gap: var(--cpd-space-1x); --mx-flex-wrap: nowrap;"
    >
      <input
