.mx_SoundVolumeSettings {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
}

.mx_SoundVolumeSetting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cpd-space-4x);
}

/* The volume slider is sized for audio players by default; give it more room here. */
.mx_SoundVolumeSetting_slider input[type="range"] {
    width: 200px;
}

.mx_SoundVolumeSetting_control {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
}

.mx_SoundVolumeSetting_value {
    min-width: 4ch;
    text-align: end;
    color: var(--cpd-color-text-secondary);
    font-variant-numeric: tabular-nums;
}
